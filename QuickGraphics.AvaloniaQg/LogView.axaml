<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:aqg="using:QuickGraphics.AvaloniaQg"
             x:DataType="aqg:LogView"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="QuickGraphics.AvaloniaQg.LogView">

    <StackPanel Background="White">
        <ScrollViewer x:Name="LogScroll">
            <StackPanel x:Name="Log" />
        </ScrollViewer>

        <Grid x:Name="ConsoleInputGrid" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock x:Name="ConsoleInputText" VerticalAlignment="Center">></TextBlock>
            <TextBox x:Name="ConsoleInput" Grid.Column="1" MaxLines="1" Height="20">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding EnterCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </Grid>
    </StackPanel>

</UserControl>
